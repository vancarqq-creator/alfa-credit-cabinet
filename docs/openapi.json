       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Amount"
     },
     "term_months": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Term Months"
     },
