{
 "info": {
  "name": "Умный кредитный кабинет",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:8000"
  },
  {
   "key": "token",
   "value": ""
  },
  {
   "key": "appId",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "1. Клиентский сценарий",
   "item": [
    {
     "name": "Вход: client1",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"login\": \"client1\",\n  \"password\": \"Demo#2026\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json(); pm.collectionVariables.set('token', j.token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Продукты",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/products",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "products"
       ]
      }
     }
    },
    {
     "name": "Поиск компании по ИНН",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/registry/lookup?inn=7701000019",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "registry",
        "lookup?inn=7701000019"
       ]
      }
     }
    },
    {
     "name": "Создать черновик",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"product\": \"working_capital\",\n  \"amount\": 1200000,\n  \"term_months\": 24,\n  \"purpose\": \"Закупка сырья\",\n  \"consent\": true,\n  \"company\": {\n    \"inn\": \"7701000019\",\n    \"name\": \"ООО «Пекарня Заря»\",\n    \"contact_name\": \"Иванова М.С.\",\n    \"contact_role\": \"Собственник\"\n  },\n  \"financials\": {\n    \"revenue_year\": 24000000,\n    \"profit_year\": 3600000,\n    \"monthly_obligations\": 40000\n  },\n  \"documents\": []\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('appId', pm.response.json().id);"
        ]
       }
      }
     ]
    },
    {
     "name": "Отправить в банк",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications/{{appId}}/submit",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications",
        "{{appId}}",
        "submit"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{}"
      }
     }
    },
    {
     "name": "Карточка заявки (повторить до OFFER_READY)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications/{{appId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications",
        "{{appId}}"
       ]
      }
     }
    },
    {
     "name": "Журнал переходов",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications/{{appId}}/events",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications",
        "{{appId}}",
        "events"
       ]
      }
     }
    },
    {
     "name": "Принять предложение",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications/{{appId}}/offer/accept",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications",
        "{{appId}}",
        "offer",
        "accept"
       ]
      }
     }
    },
    {
     "name": "Подписать договор → выдача",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications/{{appId}}/sign",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications",
        "{{appId}}",
        "sign"
       ]
      }
     }
    },
    {
     "name": "Список моих заявок",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications"
       ]
      }
     }
    }
   ]
  },
  {
   "name": "2. Банк (андеррайтер)",
   "item": [
    {
     "name": "Вход: underwriter",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"login\": \"underwriter\",\n  \"password\": \"Demo#2026\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json(); pm.collectionVariables.set('token', j.token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Очередь: на ручном рассмотрении",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/applications?status=MANUAL_REVIEW",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "applications?status=MANUAL_REVIEW"
       ]
      }
     }
    },
    {
     "name": "Статистика по статусам",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/bank/stats",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "bank",
        "stats"
       ]
      }
     }
    },
    {
     "name": "Решение: встречное предложение",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/bank/applications/{{appId}}/decision",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "bank",
        "applications",
        "{{appId}}",
        "decision"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"action\": \"counter\",\n  \"amount\": 3500000,\n  \"term_months\": 36,\n  \"comment\": \"Снижаем сумму\"\n}"
      }
     }
    },
    {
     "name": "Решение: запрос информации",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/bank/applications/{{appId}}/decision",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "bank",
        "applications",
        "{{appId}}",
        "decision"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"action\": \"request_info\",\n  \"comment\": \"Пришлите договор аренды\"\n}"
      }
     }
    },
    {
     "name": "Решение: отказ",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/bank/applications/{{appId}}/decision",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "bank",
        "applications",
        "{{appId}}",
        "decision"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"action\": \"reject\",\n  \"comment\": \"Высокий риск\"\n}"
      }
     }
    }
   ]
  },
  {
   "name": "3. Служебные",
   "item": [
    {
     "name": "Health",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/health",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "health"
       ]
      }
     }
    },
    {
     "name": "Автомат состояний",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/meta/states",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "meta",
        "states"
       ]
      }
     }
    }
   ]
  }
 ]
}